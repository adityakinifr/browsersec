<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  M0 spike runs WITHOUT the App Sandbox: creating a private aggregate audio
	  device + process tap is simplest unsandboxed during development. Before any
	  distribution we'll re-enable the sandbox and validate tap/aggregate creation
	  under it.
	-->
	<key>com.apple.security.app-sandbox</key>
	<false/>
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- Hardened runtime requires this to send Apple Events (read Spotify's
	     now-playing track). It's a standard exception — no provisioning needed. -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
</dict>
</plist>
